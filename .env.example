# Copy this file to `.env.local` for local development.
# All variables are optional — the site works without any of them.

# Optional: if set, new "Request a Demo" leads submitted via /api/lead will
# be best-effort forwarded here (e.g. a Slack incoming webhook URL, a Zapier
# "catch hook" URL, or an internal CRM ingestion endpoint). Leads are always
# logged server-side regardless of whether this is set.
#
# See src/app/api/lead/route.ts for the stubbed integration point — this is
# NOT connected to any real CRM/email provider yet.
LEAD_NOTIFY_WEBHOOK_URL=
